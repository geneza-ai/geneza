# Copy to secrets.yml, fill in, and either encrypt it with `ansible-vault
# encrypt secrets.yml` or keep it out of version control (.gitignore covers it).
#
# These have no defaults ON PURPOSE. A generated-at-random default would differ
# between runs and silently re-key the fleet; a hardcoded one would be a
# backdoor. Generate each once and keep it.
#
#   openssl rand -hex 32

# Postgres role password. The DSN is derived from it in group_vars/all.yml.
geneza_postgres_password: "CHANGE-ME"

# Mints TURN credentials. Must be IDENTICAL on every controller and relay;
# rotating it is a synchronised flag-day across the whole fleet.
geneza_relay_shared_secret: "CHANGE-ME"

# OpenStack clouds registry — omit entirely if you are not integrating with a
# cloud you operate. Keyed by a stable operator slug (the service-uid), which
# rides the vendordata path and qualifies every project binding.
geneza_clouds: {}
#   mycloud:
#     kind: openstack
#     keystone_url: https://keystone.example.com/v3
#     auto_provision: true
#     allow_human_auto_provision: true
#     launch:
#       allow: true
#       actions: [shell]

# Bootstrap console operator. WITHOUT this (and without oidc or a clouds entry)
# there is no way to sign in to the console — the deploy comes up healthy and
# unusable. files/policy.yaml binds group `admins` to ws-admin.
#
#   printf 'yourpassword' | docker run -i --rm \
#     ghcr.io/geneza-ai/geneza-controller:latest hash-password
geneza_local_admin:
  username: admin
  password_bcrypt: "CHANGE-ME"
