#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Renew this host's Geneza SERVER certificate when it is inside the renewal
# window. Idempotent and safe to run daily: outside the window it exits 0 having
# done nothing.
#
# It never touches the CA root — `reissue-tls` signs with the existing
# intermediate. Rotating the root is a separate, deliberate, overlap-window
# procedure (see rotate-ca.yml); a hard cutover is the classic way to lock
# yourself out of your own fleet.
#
# RELAYS ARE NOT HANDLED HERE, because they renew themselves. A relay attaches a
# CSR to its registrar heartbeat once its cert nears expiry and the controller
# signs it in place (internal/controller/relayregistry.go: maybeRenewRelayCert).
# The identity and SANs come from the relay's authenticated mTLS leaf and NOT
# from the CSR, so a relay can only ever renew its own cert. Driving that from
# here would mean giving relays a path into the controllers — inverting the
# trust model for a job the control plane already does correctly.
set -euo pipefail

RENEW_BEFORE_DAYS={{ geneza_cert_renew_before_days }}
log() { echo "[geneza-cert-renew] $*"; }

# Seconds of remaining validity; 0 when missing or unparseable, which forces a
# renewal rather than silently skipping a broken cert.
remaining() {
  local f="$1" end end_s now_s
  [ -r "$f" ] || { echo 0; return; }
  end=$(openssl x509 -in "$f" -noout -enddate 2>/dev/null | cut -d= -f2-) || { echo 0; return; }
  end_s=$(date -d "$end" +%s 2>/dev/null) || { echo 0; return; }
  now_s=$(date +%s)
  echo $(( end_s - now_s ))
}

{% if 'controllers' in group_names %}
CERT={{ geneza_data_dir }}/tls/controller.crt
left=$(remaining "$CERT")
if [ "$left" -gt $(( RENEW_BEFORE_DAYS * 86400 )) ]; then
  log "controller cert has $(( left / 86400 ))d left; nothing to do"
  exit 0
fi

log "controller cert has $(( left / 86400 ))d left; reissuing from the existing CA"
docker run --rm \
  --user {{ geneza_uid }}:{{ geneza_uid }} \
  -v {{ geneza_data_dir }}:/var/lib/geneza/controller \
  -v {{ geneza_conf_dir }}:/etc/geneza \
  {{ geneza_controller_image }} \
  reissue-tls --config /etc/geneza/controller.yaml

# Restarting a controller drops no live session: sessions are end-to-end between
# client and agent and ride the relay, so the controller is out of the data path.
# It briefly refuses NEW sessions, which is why the timer is jittered.
systemctl restart geneza-controller
log "controller cert renewed"
{% else %}
# Relay: report only. Renewal happens over the registrar heartbeat.
CERT=/var/lib/geneza/relay/tls/relay.crt
left=$(remaining "$CERT")
log "relay cert has $(( left / 86400 ))d left (auto-renewed via the registrar heartbeat)"
if [ "$left" -le 0 ]; then
  log "WARNING: relay cert is expired — the relay is not reaching a controller registrar"
  exit 1
fi
{% endif %}
